# change-001 — one agent turn that changed files (SPEC §5.1),
# notation per contracts/records.md; JSON mirror: change-001.json.
# Evaluable after packs/recorder.notation is loaded into the space.

# Single-document write pattern (verified on 0.8.0): bind the change entity
# with `this: ?c` on the assertion — a query expression does NOT see
# same-document assertions, so do not join with a `change:` query here.
change!:
  this: ?c
  session: "vibe-session-aaa"
  turn: "turn-1"
  agent: "hermes"
  harness: :vibe
  prompt: "Add the recorder hook runtime\n\nAlso wire the checkpoint sync and the update check."
  response: "Added src/hooks/tool.mjs with the four entry points and wired checkpoint sync."
  project: "mistral_hackathon"
  branch: "main"
  base: "4b825dc642cb6eb9a060e54bf8d69288fbee4904"
  head: "9d3f1c2a1b4e5f60718293a4b5c6d7e8f901234"
  commit: "a1b2c3d4e5f60718293a4b5c6d7e8f9012345678"
  lines-added: 150
  lines-removed: 6
  diff: |
    diff --git a/src/hooks/tool.mjs b/src/hooks/tool.mjs
    new file mode 100644
    index 0000000..1234567
    --- /dev/null
    +++ b/src/hooks/tool.mjs
    @@ -0,0 +1,5 @@
    +#!/usr/bin/env node
    +// hook runtime
    +export function main() {}
    +export function hook(event) { return 0; }
  redacted: false
  at: "2026-11-21T12:00:00Z"

# lens: one change-file per changed path, bound to the change via ?c
change-file!:
  change: ?c
  path: "src/hooks/tool.mjs"
  status: :added
  added: 120
  removed: 0

change-file!:
  change: ?c
  path: "src/hooks/README.md"
  status: :modified
  added: 30
  removed: 4

change-file!:
  change: ?c
  path: "src/old.txt"
  status: :deleted
  added: 0
  removed: 2

change-file!:
  change: ?c
  path: "src/renamed-b.txt"
  status: :renamed
  added: 0
  removed: 0
